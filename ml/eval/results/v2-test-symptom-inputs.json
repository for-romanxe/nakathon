  "locations": [],
  "loc_ok": true
 },
 {
  "cond": "sentence + metrics",
  "id": "ST-010",
  "text": "어제까지는 두통 때문에 고생했는데 자고 일어나니 말끔히 나았어요.",
  "codes": [
