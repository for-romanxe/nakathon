{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "MoodScore",
 "description": "모델 ② 출력. 기분 자유 문장 → 척도.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "mood",
  "fatigue",
  "stress",
  "confidence"
 ],
 "properties": {
  "mood": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "fatigue": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "stress": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  }
 }
}